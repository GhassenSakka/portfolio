# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de données locale
/data/*.db
/data/*.db-journal

# fichiers uploadés localement
# -> commités pour la prod (déploiement Vercel à partir du repo Git) : ce sont
#    les logos/photos déjà en place sur le site, pas des uploads jetables.
#    Les NOUVEAUX uploads faits depuis le back-office en production ne
#    persisteront pas entre deux déploiements (disque éphémère Vercel) sauf
#    passage à STORAGE_DRIVER=vercel-blob — voir README § 5.3.

# prisma (sqlite dev artifacts dans prisma/ si jamais générés)
/prisma/*.db
/prisma/*.db-journal

# export statique (option de secours, généré par `npm run export`)
/export

