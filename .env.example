# ============================================================
# Portfolio Ghassen SAKKA — variables d'environnement (exemple)
# Copiez ce fichier en ".env" puis ajustez les valeurs si besoin.
# `npm run setup` crée automatiquement un ".env" fonctionnel si absent.
# ============================================================

# --- Base de données ---
# Local : SQLite, fichier créé automatiquement dans data/portfolio.db
# (le chemin est relatif au dossier prisma/, d'où le "../")
# Production : PostgreSQL (Neon) — basculé par `npm run use:postgres`
DATABASE_URL="file:../data/portfolio.db"

# --- Session admin ---
# Secret utilisé pour signer le cookie de session HTTP-only. Doit être une
# longue chaîne aléatoire. Généré automatiquement par `npm run setup` si
# la valeur ci-dessous n'est pas changée.
SESSION_SECRET="changeme-generated-by-setup"

# --- Compte administrateur créé par le seed (npm run setup) ---
# En local uniquement : valeurs par défaut simples. Changez le mot de passe
# depuis le back-office après la première connexion.
# En production, un mot de passe fort est généré automatiquement (voir README).
ADMIN_EMAIL="admin@local.test"
ADMIN_PASSWORD="ChangeMe123!"

# --- Stockage des fichiers uploadés (images, CV PDF) ---
# "local"       -> public/uploads (par défaut, local et production simple)
# "vercel-blob" -> Vercel Blob Storage (nécessite BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=

# --- SMTP optionnel pour le formulaire de contact ---
# Laissez vide : le formulaire fonctionne quand même (messages enregistrés
# en base et visibles dans le back-office), seul l'email de notification
# est désactivé.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=

# --- URL publique du site (SEO, Open Graph, sitemap) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
